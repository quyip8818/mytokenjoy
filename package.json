{
  "name": "tokenjoy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "start": "bash scripts/dev.sh start",
    "reset": "bash scripts/dev.sh reset",
    "infra": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "build": "pnpm -F @tokenjoy/frontend build",
    "lint": "pnpm -F @tokenjoy/frontend lint && pnpm -F @tokenjoy/backend lint",
    "format": "prettier --write apps && pnpm -F @tokenjoy/backend format",
    "test": "bash scripts/dev.sh test",
    "test:integration": "pnpm -F @tokenjoy/backend test:integration",
    "test:e2e": "pnpm -F @tokenjoy/frontend test:e2e",
    "start:web": "pnpm -F @tokenjoy/web start",
    "build:web": "pnpm -F @tokenjoy/web build",
    "lint:web": "pnpm -F @tokenjoy/web lint",
    "format:web": "prettier --write apps/web/src",
    "test:web": "pnpm -F @tokenjoy/web test",
    "build:sms": "pnpm -F @sms/frontend build",
    "lint:sms": "pnpm -F @sms/frontend lint && pnpm -F @sms/backend lint",
    "test:sms": "pnpm -F @sms/frontend test && pnpm -F @sms/backend test",
    "test:sms:integration": "pnpm -F @sms/backend test:integration",
    "test:sms:e2e": "pnpm -F @sms/frontend test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.4",
    "wait-on": "^8.0.3"
  }
}
