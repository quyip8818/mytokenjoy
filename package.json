{
  "name": "tokenjoy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "start": "bash scripts/dev.sh start",
    "start:saas": "bash scripts/dev.sh start saas",
    "start:local": "bash scripts/dev.sh start local",
    "start:all": "bash scripts/dev.sh start all",
    "reset": "bash scripts/dev.sh reset",
    "infra": "docker compose -p tokenjoy-saas -f docker-compose.yml up -d --wait && docker compose -p tokenjoy-local -f docker-compose.local.yml up -d --wait",
    "infra:down": "docker compose -p tokenjoy-saas -f docker-compose.yml down && docker compose -p tokenjoy-local -f docker-compose.local.yml down",
    "build": "pnpm -F @tokenjoy/frontend build",
    "lint": "pnpm -F @tokenjoy/frontend lint && pnpm -F @tokenjoy/backend lint && pnpm -F @tokenjoy/web lint && pnpm -F @sms/frontend lint && pnpm -F @sms/backend lint",
    "format": "prettier --write \"**/*.{ts,tsx}\" && pnpm -F @tokenjoy/backend format && pnpm -F @sms/backend format",
    "test": "bash scripts/dev.sh test",
    "test:all": "bash scripts/dev.sh test:all",
    "test:integration": "bash scripts/dev.sh test:integration",
    "test:e2e": "bash scripts/dev.sh test:e2e",
    "start:web": "pnpm -F @tokenjoy/web start",
    "build:web": "pnpm -F @tokenjoy/web build",
    "test:web": "pnpm -F @tokenjoy/web test",
    "build:sms": "pnpm -F @sms/frontend build",
    "test:sms": "pnpm -F @sms/frontend test && pnpm -F @sms/backend test",
    "test:sms:integration": "pnpm -F @sms/backend test:integration",
    "test:sms:e2e": "pnpm -F @sms/frontend test:e2e",
    "deploy": "./deploy/reset.sh 47.99.63.146"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.4",
    "wait-on": "^8.0.3"
  }
}
