# Defaults for standalone `make start` (Local mode).
# Overridden by start-local.sh / start-saas.sh via env exports.
DATABASE_URL=postgres://tokenjoy:tokenjoy@127.0.0.1:5520/tokenjoy?sslmode=disable
PORT=8011
CORS_ORIGINS=http://localhost:9192,http://localhost:5176
DEPLOY_ENV=local
# CLOCK_ANCHOR= (removed — production must use real system time)
SECURE_COOKIE=false
SIMULATE_DELAY=true

SESSION_SECRET=tokenjoy-dev-session-secret-local
INVITE_SECRET=065d16aaaf7457999e5876d921263150c69f0177b772b701c7450a2510aa1cb0
DATA_SOURCE_CREDENTIAL_KEY=dGV2LWNyZWRlbnRpYWwta2V5LWZvci1sb2NhbC1kZXY=

NEW_API_ENABLED=true
NEW_API_GATEWAY_ENABLED=true
NEW_API_BASE_URL=http://127.0.0.1:3011
NEW_API_ADMIN_USER_ID=1
LOG_DATABASE_URL=postgres://tokenjoy:tokenjoy@127.0.0.1:5520/logs?sslmode=disable
NEW_API_WEBHOOK_SECRET=tokenjoy-webhook-secret

REDIS_URL=redis://127.0.0.1:6320/2

PLATFORM_BOOTSTRAP_EMAIL=admin@tokenjoy.me
PLATFORM_BOOTSTRAP_PASSWORD=admin1234


# Local → SaaS registration (setup flow calls SaaS to register company)
SAAS_PLATFORM_URL=http://127.0.0.1:8010
SAAS_REGISTRATION_SECRET=dev-local-registration-secret
