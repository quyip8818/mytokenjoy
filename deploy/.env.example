# 阿里云 ACR 镜像仓库
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/tokenjoy
IMAGE_TAG=latest

# PostgreSQL
PG_USER=tokenjoy
PG_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# Apps 后端
SESSION_SECRET=CHANGE_ME_random_32_chars
NEWAPI_ADMIN_TOKEN=CHANGE_ME_newapi_admin_token
WEBHOOK_SECRET=CHANGE_ME_webhook_signing_secret

# SMS 后端
SMS_SESSION_SECRET=CHANGE_ME_random_32_chars

# NewAPI (apps fork)
NEWAPI_SESSION_SECRET=CHANGE_ME_random_32_chars

# NewAPI (sms, upstream image)
SMS_NEWAPI_SESSION_SECRET=CHANGE_ME_random_32_chars
